[Unit]
Description=MyAI local model server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myai
Group=myai
WorkingDirectory=/opt/myai
EnvironmentFile=/etc/myai-server.env
Environment=MYAI_MODEL_CACHE=/var/lib/myai/models
StateDirectory=myai
StateDirectoryMode=0750
ExecStart=/opt/myai/.venv/bin/python /opt/myai/server/myai_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
